# ---------------------------------------------------------------------------
# Frontend environment — PUBLIC values only (safe to expose in the browser).
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Supabase project (spec §7: URL + anon key are the only public-safe values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the deployed app (payment / auth redirects)
VITE_APP_URL=http://localhost:5173

# Optional monitoring
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# NEVER place the following in this file or anywhere in the frontend:
#   PAYMONGO_SECRET_KEY        -> Supabase Edge Function secret
#   PAYMONGO_WEBHOOK_SECRET    -> Supabase Edge Function secret
#   SEM_API_KEY                -> Supabase Edge Function secret
#   SUPABASE_SERVICE_ROLE_KEY  -> Supabase Edge Function secret
#   CRON_SECRET                -> Supabase Edge Function secret
# ---------------------------------------------------------------------------
